# URL base de la API, incluyendo el sufijo /api y SIN barra final.
# La ruta de imágenes (/uploads) se deriva quitando el /api.
#
# Local:      http://localhost:3000/api
# Producción: https://<tu-servicio>.up.railway.app/api
#
# Ojo: en Vite las variables se incrustan en el bundle EN TIEMPO DE BUILD.
# Si la cambias en Vercel hay que volver a desplegar; no basta con reiniciar.
VITE_BASE_URL=http://localhost:3000/api
