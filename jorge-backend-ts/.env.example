# ---------------------------------------------------------------------------
# Plantilla de variables del backend. Copia a .env y rellena.
# El .env NUNCA se sube al repositorio.
# ---------------------------------------------------------------------------

# --- Base de datos ---------------------------------------------------------
# En Railway puedes referenciar el servicio MySQL en vez de copiar valores:
#   DB_HOST=${{MySQL.MYSQLHOST}}
#   DB_PORT=${{MySQL.MYSQLPORT}}
#   ...
# También se leen directamente MYSQLHOST/MYSQLPORT/MYSQLDATABASE/MYSQLUSER/
# MYSQLPASSWORD si prefieres no duplicar nada.
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=biocan
DB_USERNAME=root
DB_PASSWORD=

# true si la MySQL gestionada exige TLS (conexión pública).
DB_SSL=false

# Log de cada query de Sequelize. Déjalo en false en producción.
DB_LOGGING=false

# false para que Sequelize no toque el esquema al arrancar (recomendado en
# producción una vez importado el dump).
DB_SYNC=true

# --- Seguridad -------------------------------------------------------------
# Genera uno largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# --- Servidor --------------------------------------------------------------
# El PaaS suele inyectar PORT automáticamente; no hace falta ponerlo.
PORT=3000
NODE_ENV=development

# Orígenes autorizados para CORS, separados por comas y sin barra final.
# Admite comodín de subdominio para los preview de Vercel:
#   CORS_ORIGINS=https://biocan.vercel.app,https://*.vercel.app
CORS_ORIGINS=http://localhost:5173

# Pon false solo si el front y la API comparten dominio
# (p. ej. biocan.es + api.biocan.es), para usar cookies SameSite=lax.
CROSS_SITE_COOKIES=true

# --- Ficheros y logs -------------------------------------------------------
# Carpeta de imágenes subidas. En un PaaS apunta a un volumen persistente
# (p. ej. /data/uploads) o se pierden en cada despliegue.
UPLOADS_DIR=

# true para escribir además logs en fichero. En un PaaS déjalo en false:
# los logs se leen por consola.
LOG_TO_FILE=false
LOG_LEVEL=info
